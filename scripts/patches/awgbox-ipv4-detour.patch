+func bindFamiliesFromIPC(ipcConfig string) (enableIPv4 bool, enableIPv6 bool) {
+	foundEndpoint := false
+	for _, line := range strings.Split(ipcConfig, "\n") {
+		if !strings.HasPrefix(line, "endpoint=") {
+			continue
+		}
+		endpoint, err := netip.ParseAddrPort(strings.TrimPrefix(line, "endpoint="))
+		if err != nil {
+			continue
+		}
+		foundEndpoint = true
+		if endpoint.Addr().Unmap().Is4() {
+			enableIPv4 = true
+		} else {
+			enableIPv6 = true
+		}
+	}
+	if !foundEndpoint {
+		return true, true
+	}
+	return enableIPv4, enableIPv6
+}

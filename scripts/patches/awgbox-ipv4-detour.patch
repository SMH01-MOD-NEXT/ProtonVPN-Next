+package box_test
+
+import (
+	"context"
+	"fmt"
+	"testing"
+
+	box "github.com/sagernet/sing-box"
+	"github.com/sagernet/sing-box/include"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common/json"
+)
+
+// Startup, not just config parsing. No TUN, routes, DNS, registration or external
+// peers: the physical endpoint is loopback and persistent keepalives are off.
+func TestIPv4OnlyDetourStartsAwg(t *testing.T) {
+	for _, kind := range []string{"wireguard", "awg"} {
+		t.Run(kind, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(include.Context(context.Background()))
+			defer cancel()
+			raw := fmt.Sprintf(`{
+    "log":{"disabled":true},
+    "endpoints":[
+     {"type":"awg","tag":"proton-awg","useIntegratedTun":false,
+      "address":["10.2.0.2/32"],"private_key":"AQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQE=",
+      "detour":"warp","peers":[{"address":"192.0.2.10","port":2408,
+       "public_key":"AgICAgICAgICAgICAgICAgICAgICAgICAgICAgICAgI=","allowed_ips":["0.0.0.0/0"]}]},
+     {"type":"%s","tag":"warp","address":["172.16.0.2/32"],
+      "private_key":"AwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwM=",
+      "peers":[{"address":"127.0.0.1","port":9,
+       "public_key":"BAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQEBAQ=","allowed_ips":["0.0.0.0/0"]}]}],
+    "route":{"final":"proton-awg"}}`, kind)
+			opts, err := json.UnmarshalExtendedContext[option.Options](ctx, []byte(raw))
+			if err != nil {
+				t.Fatal(err)
+			}
+			instance, err := box.New(box.Options{Context: ctx, Options: opts})
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer instance.Close()
+			if err = instance.Start(); err != nil {
+				t.Fatalf("IPv4-only %s detour must start AWG without IPv6: %v", kind, err)
+			}
+		})
+	}
+}

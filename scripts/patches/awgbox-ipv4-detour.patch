@@ -0,0 +1,23 @@
+package awg
+
+import (
+	"errors"
+	M "github.com/sagernet/sing/common/metadata"
+	"net/netip"
+	"syscall"
+	"testing"
+)
+
+func TestAbsentAddressFamilyIsUnsupported(t *testing.T) {
+	stack := &stackTun{inet4Address: netip.MustParseAddr("172.16.0.2")}
+	if _, err := stack.bindAddress(M.Socksaddr{Addr: netip.IPv6Unspecified()}); !errors.Is(err, syscall.EAFNOSUPPORT) {
+		t.Fatalf("IPv4-only stack must report EAFNOSUPPORT, got %v", err)
+	}
+	if addr, err := stack.bindAddress(M.Socksaddr{Addr: netip.IPv4Unspecified()}); err != nil || addr != stack.inet4Address {
+		t.Fatalf("IPv4 must remain available: %v, %v", addr, err)
+	}
+	stack = &stackTun{inet6Address: netip.MustParseAddr("2001:db8::1")}
+	if _, err := stack.bindAddress(M.Socksaddr{Addr: netip.IPv4Unspecified()}); !errors.Is(err, syscall.EAFNOSUPPORT) {
+		t.Fatalf("IPv6-only stack must report EAFNOSUPPORT, got %v", err)
+	}
+}

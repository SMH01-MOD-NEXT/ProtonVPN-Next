diff --git a/transport/awg/bind_test.go b/transport/awg/bind_test.go
new file mode 100644
index 0000000..cf770a1
--- /dev/null
+++ b/transport/awg/bind_test.go
@@ -0,0 +1,25 @@
+package awg
+
+import (
+    "errors"
+    "fmt"
+    "syscall"
+    "testing"
+)
+
+func TestAddressFamilyUnavailable(t *testing.T) {
+    for _, err := range []error{
+        syscall.EAFNOSUPPORT,
+        syscall.EADDRNOTAVAIL,
+        syscall.ENETUNREACH,
+        syscall.EHOSTUNREACH,
+        fmt.Errorf("wrapped: %w", syscall.ENETUNREACH),
+    } {
+        if !isAddressFamilyUnavailable(err) {
+            t.Errorf("expected %v to be treated as unavailable address family", err)
+        }
+    }
+    if isAddressFamilyUnavailable(errors.New("permission denied")) {
+        t.Fatal("unrelated errors must remain fatal")
+    }
+}

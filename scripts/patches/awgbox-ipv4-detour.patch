diff --git a/transport/awg/bind_detour_test.go b/transport/awg/bind_detour_test.go
new file mode 100644
index 0000000..69c0ce6
--- /dev/null
+++ b/transport/awg/bind_detour_test.go
@@ -0,0 +1,92 @@
+package awg
+
+import (
+	"context"
+	"errors"
+	M "github.com/sagernet/sing/common/metadata"
+	"net"
+	"syscall"
+	"testing"
+	"time"
+)
+
+type detourTestPacket struct{ closed bool }
+
+func (c *detourTestPacket) ReadFrom([]byte) (int, net.Addr, error)    { return 0, nil, net.ErrClosed }
+func (c *detourTestPacket) WriteTo(p []byte, _ net.Addr) (int, error) { return len(p), nil }
+func (c *detourTestPacket) Close() error                              { c.closed = true; return nil }
+func (c *detourTestPacket) LocalAddr() net.Addr                       { return &net.UDPAddr{IP: net.IPv4zero} }
+func (c *detourTestPacket) SetDeadline(time.Time) error               { return nil }
+func (c *detourTestPacket) SetReadDeadline(time.Time) error           { return nil }
+func (c *detourTestPacket) SetWriteDeadline(time.Time) error          { return nil }
+
+type detourTestDialer struct {
+	v4, v6 *detourTestPacket
+	e4, e6 error
+}
+
+func (d *detourTestDialer) DialContext(context.Context, string, M.Socksaddr) (net.Conn, error) {
+	panic("unexpected direct dial")
+}
+func (d *detourTestDialer) ListenPacket(_ context.Context, dst M.Socksaddr) (net.PacketConn, error) {
+	if dst.IsIPv4() {
+		if d.e4 != nil {
+			return nil, d.e4
+		}
+		return d.v4, nil
+	}
+	if d.e6 != nil {
+		return nil, d.e6
+	}
+	return d.v6, nil
+}
+func TestDetourBindSingleFamilyAndClose(t *testing.T) {
+	for _, ipv6 := range []bool{false, true} {
+		t.Run(map[bool]string{false: "ipv4", true: "ipv6"}[ipv6], func(t *testing.T) {
+			p := &detourTestPacket{}
+			d := &detourTestDialer{v4: p, e6: syscall.EAFNOSUPPORT}
+			if ipv6 {
+				d = &detourTestDialer{v6: p, e4: syscall.EAFNOSUPPORT}
+			}
+			b := newBind(context.Background(), d)
+			fns, _, err := b.Open(0)
+			if err != nil || len(fns) != 1 {
+				t.Fatalf("single-family bind: %v, %d", err, len(fns))
+			}
+			addr := "192.0.2.1:2408"
+			if ipv6 {
+				addr = "[2001:db8::1]:2408"
+			}
+			ep, err := b.ParseEndpoint(addr)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err = b.Send([][]byte{{1, 2, 3}}, ep); err != nil {
+				t.Fatal(err)
+			}
+			if err = b.Close(); err != nil {
+				t.Fatal(err)
+			}
+			if !p.closed {
+				t.Fatal("bind leaked its packet connection")
+			}
+		})
+	}
+}
+func TestDetourBindFatalErrorClosesPartialConnection(t *testing.T) {
+	p := &detourTestPacket{}
+	fatal := errors.New("detour denied")
+	b := newBind(context.Background(), &detourTestDialer{v4: p, e6: fatal})
+	if _, _, err := b.Open(0); !errors.Is(err, fatal) {
+		t.Fatalf("must propagate fatal detour errors: %v", err)
+	}
+	if !p.closed {
+		t.Fatal("IPv4 socket leaked after IPv6 open failure")
+	}
+}
+func TestDetourBindNoFamiliesFailsClosed(t *testing.T) {
+	b := newBind(context.Background(), &detourTestDialer{e4: syscall.EAFNOSUPPORT, e6: syscall.EAFNOSUPPORT})
+	if _, _, err := b.Open(0); !errors.Is(err, syscall.EAFNOSUPPORT) {
+		t.Fatalf("must reject a detour with no supported family: %v", err)
+	}
+}

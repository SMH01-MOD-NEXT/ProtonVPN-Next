diff --git a/transport/awg/bind_test.go b/transport/awg/bind_test.go
new file mode 100644
index 0000000..211e7c6
--- /dev/null
+++ b/transport/awg/bind_test.go
@@ -0,0 +1,48 @@
+package awg
+
+import (
+	"errors"
+	"fmt"
+	"syscall"
+	"testing"
+)
+
+func TestAddressFamilyUnavailable(t *testing.T) {
+	for _, err := range []error{
+		syscall.EAFNOSUPPORT,
+		syscall.EADDRNOTAVAIL,
+		syscall.ENETUNREACH,
+		syscall.EHOSTUNREACH,
+		fmt.Errorf("wrapped: %w", syscall.ENETUNREACH),
+	} {
+		if !isAddressFamilyUnavailable(err) {
+			t.Errorf("expected %v to be treated as unavailable address family", err)
+		}
+	}
+	if isAddressFamilyUnavailable(errors.New("permission denied")) {
+		t.Fatal("unrelated errors must remain fatal")
+	}
+}
+
+func TestBindFamiliesFromIPC(t *testing.T) {
+	tests := []struct {
+		name     string
+		ipc      string
+		wantIPv4 bool
+		wantIPv6 bool
+	}{
+		{name: "IPv4 only", ipc: "endpoint=192.0.2.1:443", wantIPv4: true},
+		{name: "IPv6 only", ipc: "endpoint=[2001:db8::1]:443", wantIPv6: true},
+		{name: "dual stack", ipc: "endpoint=192.0.2.1:443\nendpoint=[2001:db8::1]:443", wantIPv4: true, wantIPv6: true},
+		{name: "server mode", ipc: "listen_port=51820", wantIPv4: true, wantIPv6: true},
+		{name: "malformed endpoint", ipc: "endpoint=not-an-address", wantIPv4: true, wantIPv6: true},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			gotIPv4, gotIPv6 := bindFamiliesFromIPC(test.ipc)
+			if gotIPv4 != test.wantIPv4 || gotIPv6 != test.wantIPv6 {
+				t.Fatalf("got IPv4=%v IPv6=%v, want IPv4=%v IPv6=%v", gotIPv4, gotIPv6, test.wantIPv4, test.wantIPv6)
+			}
+		})
+	}
+}

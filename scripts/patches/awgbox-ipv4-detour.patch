 			w.bindAccess.Unlock()
 			return nil
 		})
+	case adapter.StartStateStart:
+		if err := w.endpoint.Start(false); err != nil {
+			return err
+		}
+		// AWG dependants open UDP binds during this phase, before PostStart.
+		// Numeric peers are already usable; do not report a ready device as
+		// unavailable merely because the next lifecycle phase has not run.
+		w.started.Store(w.endpoint.Ready())
+	case adapter.StartStatePostStart:
+		err := w.endpoint.Start(true)
+		if err != nil {
+			return err
+		}
+		w.started.Store(w.endpoint.Ready())
 	}
 	return nil
 }

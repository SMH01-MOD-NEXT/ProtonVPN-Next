+func (t *Outbound) waitBootstrap(instance *tor.Tor) error {
+	ctx, cancel := context.WithTimeout(t.ctx, 90*time.Second)
+	defer cancel()
+	ticker := time.NewTicker(250 * time.Millisecond)
+	defer ticker.Stop()
+	lastProgress := ""
+	for {
+		info, err := instance.Control.GetInfo("status/bootstrap-phase")
+		if err == nil && len(info) == 1 {
+			status := info[0].Val
+			if strings.Contains(status, "PROGRESS=100") {
+				t.logger.Info("tor bootstrap completed")
+				return nil
+			}
+			if status != lastProgress {
+				t.logger.Info("tor bootstrap: ", status)
+				lastProgress = status
+			}
+		}
+		select {
+		case <-ctx.Done():
+			return E.Cause(ctx.Err(), "tor bootstrap")
+		case <-ticker.C:
+		}
+	}
+}

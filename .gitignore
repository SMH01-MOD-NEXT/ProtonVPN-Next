# IDE / Editor files
.idea/
*.iml
*.ipr
*.iws
.navigation/
.artifacts/

# Gradle files & caches
.gradle/
/local.properties
sentry.properties

# Build & compiled outputs
build/
**/build/
captures/
.externalNativeBuild/
.cxx/

# Kotlin / Compiler daemon caches
.kotlin/

# Android & Desktop build outputs (APKs, bundles, libraries)
*.apk
*.aar
*.aab
app/stable/
desktop/libs/

# Generated security metadata
**/security_metadata.h

# External / nested repos or builds (e.g. Go-based VPN cores)
vpn-core/

# Environment, logs, and local runtime data
.env
.env.*
*.log
*.db
*.sqlite

# OS-specific files
.DS_Store
Thumbs.db

# AWGBox is generated locally by scripts/build-awgbox-lib.sh.
# The pinned source revision and build recipe remain in scripts/build-awgbox-lib.sh.

# Android Studio occasionally drops build output next to the module instead of
# under app/build/, which keeps getting picked up by "git add -A".
app/*/*/output-metadata.json
